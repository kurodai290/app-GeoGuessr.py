body {
    margin: 0;
    font-family: Arial, sans-serif;
    text-align: center;
    background: #222;
    color: white;
}

h1 {
    padding: 10px;
}

#game {
    display: flex;
    height: 80vh;
}

#streetview {
    width: 70%;
    border: none;
}

#map {
    width: 30%;
    height: 100%;
}

button {
    margin: 10px;
    padding: 10px 20px;
    font-size: 18px;
    cursor: pointer;
}

#result {
    font-size: 20px;
}
